{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SwinBaseModelCatalog",
  "type": "object",
  "required": ["schemaVersion", "catalogVersion", "entries"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "catalogVersion": {"type": "string", "minLength": 1},
    "entries": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["modelDescriptorId", "modelDescriptorVersion", "timmModelName", "source", "license", "input", "qualification"],
        "properties": {
          "modelDescriptorId": {"type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"},
          "modelDescriptorVersion": {"type": "string", "minLength": 1},
          "timmModelName": {"type": "string", "minLength": 1},
          "source": {
            "type": "object",
            "required": ["repoId", "revision", "files"],
            "properties": {
              "repoId": {"type": "string", "minLength": 1},
              "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
              "files": {
                "type": "array", "minItems": 1,
                "items": {
                  "type": "object", "required": ["path", "digest"],
                  "properties": {
                    "path": {"type": "string", "minLength": 1},
                    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
                  }, "additionalProperties": false
                }
              }
            }, "additionalProperties": false
          },
          "license": {
            "type": "object", "required": ["spdx", "datasetTerms"],
            "properties": {"spdx": {"type": "string", "minLength": 1}, "datasetTerms": {"type": "string", "minLength": 1}},
            "additionalProperties": false
          },
          "input": {
            "type": "object", "required": ["height", "width"],
            "properties": {"height": {"type": "integer", "minimum": 1}, "width": {"type": "integer", "minimum": 1}},
            "additionalProperties": false
          },
          "qualification": {
            "type": "object", "required": ["status", "reason", "measuredEnvelope"],
            "properties": {
              "status": {"enum": ["BLOCKED", "QUALIFIED"]},
              "reason": {"type": "string", "minLength": 1},
              "measuredEnvelope": {
                "oneOf": [
                  {"type": "null"},
                  {
                    "type": "object",
                    "required": ["baseImageDigest", "torchVersion", "cudaVersion", "device", "peakVramMiB", "height", "width", "evidenceDigest"],
                    "properties": {
                      "baseImageDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
                      "torchVersion": {"type": "string", "minLength": 1},
                      "cudaVersion": {"type": "string", "minLength": 1},
                      "device": {"type": "string", "minLength": 1},
                      "peakVramMiB": {"type": "number", "minimum": 0},
                      "height": {"type": "integer", "minimum": 1},
                      "width": {"type": "integer", "minimum": 1},
                      "evidenceDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
                    }, "additionalProperties": false
                  }
                ]
              }
            }, "additionalProperties": false
          }
        }, "additionalProperties": false
      }
    }
  }, "additionalProperties": false
}
